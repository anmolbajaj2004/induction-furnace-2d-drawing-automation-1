# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: used by the model picker in the header (server side only).
# Put the real key in a file named .env next to this one, then restart the server.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Login (email OTP, only @kognitoai.com addresses) ---
# SESSION_SECRET: long random string used to sign login cookies (keeps users logged in across restarts).
SESSION_SECRET="MY_RANDOM_SECRET"
# SMTP account that sends the OTP mails. Without it, in development the OTP is printed in the server console.
SMTP_HOST="anmol.kognitoai.com"
SMTP_PORT="587"
SMTP_USER="anmol@kognitoai.com"
SMTP_PASS="Kai$2004"
SMTP_FROM="Vulcan CAD <no-reply@kognitoai.com>"

# --- Deployment (AWS etc.) ---
# NODE_ENV=production on the server. Use HTTPS: the login cookie is Secure in production.
# TRUST_PROXY=1 when the app sits behind one load balancer / reverse proxy (ALB, nginx).
# COOKIE_SECURE=false only if you must serve over plain HTTP (not recommended).
# TRUST_PROXY="1"
# COOKIE_SECURE="true"
